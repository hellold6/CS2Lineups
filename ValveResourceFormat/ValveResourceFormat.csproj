<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Source 2 resource parsing and grenade simulation for the CS2 lineup tool</Description>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);NU5104;CS8002</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
      <EmbeddedResource Include="Utils\RobotoAscii.ttf" />
      <EmbeddedResource Include="Utils\vfx_zstd_2bc2fa87.bin" />
      <EmbeddedResource Include="Utils\vfx_zstd_255df362.bin" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.5" />
    <PackageReference Include="TinyBCSharp" Version="0.1.2" />
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <PackageReference Include="ValvePak" Version="4.0.0.142" />
    <PackageReference Include="Vortice.SpirvCross" Version="1.5.4" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ValveResourceFormat.Utils" />
  </ItemGroup>
</Project>
